# VeriFact manuscript judge profile
VERIFACT_MODEL=Gemma-3-27B
VERIFACT_OUTPUT_SUBDIR=verifact_gemma3_27B
IS_REASONING_MODEL=false
LLM_MODEL_NAME=google/gemma-3-27b-it
TOKENIZER_MODEL_NAME=google/gemma-3-27b-it
LLM_CHAT_TEMPLATE_ENABLE_THINKING=
DTYPE=auto
LLM_MAX_MODEL_LEN=40000
MAIN_VLLM_USE_V1=1
EXTRA_ARGS="--enable-prefix-caching --max-num-seqs=512 --quantization=fp8 --kv-cache-dtype=auto --limit-mm-per-prompt image=0"
