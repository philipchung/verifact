# VeriFact manuscript judge profile (Qwen thinking explicitly disabled)
VERIFACT_MODEL=Qwen-3-32B
VERIFACT_OUTPUT_SUBDIR=verifact_qwen3_32B
IS_REASONING_MODEL=false
LLM_MODEL_NAME=Qwen/Qwen3-32B-FP8
TOKENIZER_MODEL_NAME=Qwen/Qwen3-32B-FP8
LLM_CHAT_TEMPLATE_ENABLE_THINKING=false
DTYPE=auto
LLM_MAX_MODEL_LEN=16000
MAIN_VLLM_USE_V1=1
EXTRA_ARGS="--enable-prefix-caching --num-scheduler-steps=1 --max-num-seqs=512 --quantization=fp8 --kv-cache-dtype=auto"
